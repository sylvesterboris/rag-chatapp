# ─────────────────────────────────────────────
#  RAG Creator Chatbot — Environment Variables
# ─────────────────────────────────────────────

# OpenAI (used for embeddings + LLM)
OPENAI_API_KEY=sk-...

# Optional: use Cohere embeddings instead of OpenAI
# COHERE_API_KEY=...

# ChromaDB persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./chroma_db

# Optional: if using Pinecone instead of ChromaDB
# PINECONE_API_KEY=...
# PINECONE_ENV=...
# PINECONE_INDEX=...

# YouTube Data API v3 (for metadata: views, likes, comments, subscribers)
YOUTUBE_API_KEY=AIza...

# RapidAPI key (used for Instagram metadata via RapidAPI Instagram scraper)
RAPIDAPI_KEY=...

# CORS origins allowed (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM Model selection
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Chunk settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
